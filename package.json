{
  "name": "dsh-bayes-predict",
  "version": "1.1.0",
  "description": "贝叶斯个股预测插件：卡尔曼增益融合的上涨概率估计、策略回测与全市场选股、自选股实时跟踪（A 股 + 美股）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/kalman.test.mjs && node test/smoke.mjs && node test/pinyin.test.mjs && node test/screen.test.mjs && node test/watchlist.test.mjs && node test/realtime.test.mjs && node test/routes.test.mjs && node test/client-render.test.mjs && node test/normalize.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "stock",
    "bayes",
    "kalman",
    "prediction",
    "backtest",
    "watchlist",
    "finance",
    "a-share",
    "quant"
  ],
  "author": "pg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pg527322814/dsh-bayes-predict.git"
  },
  "bugs": {
    "url": "https://github.com/pg527322814/dsh-bayes-predict/issues"
  },
  "homepage": "https://github.com/pg527322814/dsh-bayes-predict#readme",
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ]
}
